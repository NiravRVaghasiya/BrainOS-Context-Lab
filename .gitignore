# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example
*.secret

# Runtime data and generated evaluation artifacts
*.sqlite3
*.db
# Large generated benchmark tiers (the committed dataset is dataset.jsonl).
# The datasets stay local; their manifests are tiny provenance records and are
# committed so a run's dataset_sha256 can be tied to the parameters that made it.
benchmarks/context_rot/generated/*
!benchmarks/context_rot/generated/*.manifest.json
results/raw/*
results/aggregated/*
results/plots/*
results/report/*
# Phase 17: the Evaluation tab writes session-scoped runs under results/ui/.
results/ui/*
!results/.gitkeep

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
